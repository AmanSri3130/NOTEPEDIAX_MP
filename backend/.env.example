PORT=5000
MONGO_URI=
GROQ_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
NODE_ENV=development

# Private adaptive learning engine (server-to-server only)
ADAPTIVE_ENGINE_URL=http://127.0.0.1:8000
ADAPTIVE_ENGINE_API_KEY=replace-with-the-same-long-random-key-as-engine

# Elite email agent
EMAIL_AGENT_MODEL=openai/gpt-oss-20b
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

PAYMENT_UPI_VPA=

# Optional legacy Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/database
